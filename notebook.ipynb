    "axes[1].set_ylabel('Persentase Error (%)', fontsize=11, fontweight='bold')\n",
    "for p in axes[1].patches:\n",
    "    val = p.get_height()\n",
    "    if val > 0:\n",
    "        axes[1].annotate(f'{val:.2f}%', (p.get_x() + p.get_width() / 2., val + 0.5), ha='center', va='bottom', fontsize=10, fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(os.path.join('images', 'grafik_hasil_smart_mustahik.png'), dpi=300, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"[CELL 6 SELESAI] Grafik 300 DPI berhasil disimpan ke 'images/grafik_hasil_smart_mustahik.png'.\")"
   ]
