   "source": [
    "# SMART-MUSTAHIK: Pemrosesan Engine Data & Machine Learning\n",
    "\n",
    "**Judul KTIQ**: SMART-MUSTAHIK: Sistem Pendukung Keputusan Penyaluran Zakat Presisi Menggunakan Analisis Spasial Berbasis QS. At-Taubah: 60\n",
    "\n",
    "Notebook ini berfungsi sebagai **Mesin Pemrosesan Utama** yang menangani impor pustaka, pemrosesan dataset sosio-ekonomi BPS, integrasi indikator geospasial satelit NTL (VIIRS), formulasi label Fiqih Kifayah (QS. At-Taubah: 60), pelatihan model Machine Learning Random Forest, kalkulasi metrik efektivitas zakat (*Inclusion & Exclusion Error*), serta penyimpan grafik beresolusi tinggi (300 DPI) ke direktori `images/`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ==============================================================================\n",
    "# CELL 1: IMPORT LIBRARIES & SETUP LINGKUNGAN EKSPERIMEN\n",
    "# ==============================================================================\n",
    "\n",
    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score, precision_score, recall_score, f1_score,\n",
    "    confusion_matrix, classification_report\n",
    ")\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Membuat direktori kerja jika belum ada\n",
    "os.makedirs(\"data\", exist_ok=True)\n",
    "os.makedirs(\"images\", exist_ok=True)\n",
    "\n",
    "# Pengaturan Random Seed untuk Reproduksibilitas (Seed = 42)\n",
    "SEED = 42\n",
    "np.random.seed(SEED)\n",
    "\n",
    "sns.set_theme(style=\"whitegrid\", font_scale=1.1)\n",
    "print(\"[CELL 1 SELESAI] Pustaka dan seed = 42 berhasil dikonfigurasi.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ==============================================================================\n",
    "# CELL 2: LOAD DATASET BPS / GENERASI DATASET STRUKTUR BPS (10.000 SAMPEL)\n",
    "# ==============================================================================\n",
    "\n",
    "def muat_atau_generasi_dataset(file_path=os.path.join('data', 'data_bps.csv'), n_samples=10000):\n",
    "    if os.path.exists(file_path):\n",
    "        print(f\"Memuat dataset BPS dari '{file_path}'...\")\n",
    "        df = pd.read_csv(file_path)\n",
    "    else:\n",
    "        target_sintetis = os.path.join('data', 'data_bps_sintetis.csv')
    "        if os.path.exists(target_sintetis):\n",
    "            print(f\"Memuat dataset sintetis terstruktur BPS dari '{target_sintetis}'...\")\n",
    "            df = pd.read_csv(target_sintetis)\n",
    "        else:\n",
    "            print(f\"Menggenerasi {n_samples:,} sampel dataset sosio-ekonomi BPS & Satelit NTL...\")\n",
    "            pendapatan_total = np.random.lognormal(mean=14.5, sigma=0.6, size=n_samples)\n",
    "            tanggungan = np.random.poisson(lam=3, size=n_samples) + 1\n",
    "            pendapatan_per_kapita = pendapatan_total / tanggungan\n",
    "            skor_aset = np.random.uniform(10.0, 95.0, size=n_samples)\n",
    "            kualitas_hunian = np.random.choice([1, 2, 3, 4, 5], size=n_samples, p=[0.15, 0.25, 0.30, 0.20, 0.10])\n",
    "            akses_sanitasi = np.random.choice([0, 1], size=n_samples, p=[0.35, 0.65])\n",
    "            radiasi_satelit_ntl = np.random.uniform(0.1, 50.0, size=n_samples)\n",
    "\n",
    "            df = pd.DataFrame({\n",
    "                'pendapatan_per_kapita': np.round(pendapatan_per_kapita, 2),\n",
    "                'skor_aset': np.round(skor_aset, 2),\n",
    "                'jumlah_tanggungan': tanggungan,\n",
    "                'kualitas_hunian': kualitas_hunian,\n",
    "                'akses_sanitasi': akses_sanitasi,\n",
    "                'radiasi_satelit_ntl': np.round(radiasi_satelit_ntl, 2)\n",
    "            })\n",
    "            df.to_csv(target_sintetis, index=False)\n",
    "            print(f\"Dataset sintetis disimpan ke '{target_sintetis}'.\")\n",
    "    return df\n",
    "\n",
    "df_bps = muat_atau_generasi_dataset()\n",
    "print(f\"Dimensi Dataset: {df_bps.shape[0]:,} baris x {df_bps.shape[1]} kolom\")\n",
    "display(df_bps.head())\n",
    "print(\"[CELL 2 SELESAI] Dataset sosio-ekonomi BPS & NTL siap digunakan.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ==============================================================================\n",
    "# CELL 3: FORMULASI LABEL MUSTAHIK BERBASIS QS. AT-TAUBAH: 60 & FIQIH KIFAYAH\n",
    "# ==============================================================================\n",
    "\n",
    "HAD_KIFAYAH = 1800000\n",
    "\n",
    "def formulasi_status_mustahik(row):\n",
    "    pk = row['pendapatan_per_kapita']\n",
    "    kh = row['kualitas_hunian']\n",
    "    sa = row['skor_aset']\n",
    "    \n",
    "    # Fakir: Pendapatan < 50% Had Kifayah DAN Kualitas Hunian <= 2\n",
    "    is_fakir = (pk < 0.5 * HAD_KIFAYAH) and (kh <= 2)\n",
    "    # Miskin: Pendapatan < 100% Had Kifayah DAN Skor Aset < 40\n",
    "    is_miskin = (pk < HAD_KIFAYAH) and (sa < 40)\n",
    "    \n",
    "    return 1 if (is_fakir or is_miskin) else 0\n",
    "\n",
    "df_bps['status_mustahik'] = df_bps.apply(formulasi_status_mustahik, axis=1)\n",
    "\n",
    "# Visualisasi & Menyimpan Grafik Distribusi\n",
    "plt.figure(figsize=(8, 5))\n",
    "ax = sns.countplot(data=df_bps, x='status_mustahik', hue='status_mustahik', palette=['#3498db', '#e74c3c'], legend=False)\n",
    "plt.title('Distribusi Status Mustahik (QS. At-Taubah: 60)', fontsize=13, fontweight='bold', pad=12)\n",
    "plt.xlabel('Status (0: Non-Mustahik, 1: Mustahik)', fontweight='bold')\n",
    "plt.ylabel('Jumlah Rumah Tangga', fontweight='bold')\n",
    "plt.xticks([0, 1], ['Non-Mustahik (Mampu)', 'Mustahik (Fakir/Miskin)'])\n",
    "for p in ax.patches:\n",
    "    h = p.get_height()\n",
    "    if h > 0:\n",
    "        ax.annotate(f'{h:,} ({h/len(df_bps)*100:.1f}%)', (p.get_x() + p.get_width() / 2., h / 2),\n",
    "                    ha='center', va='center', color='white', fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.savefig(os.path.join('images', 'distribusi_mustahik.png'), dpi=300)\n",
    "plt.show()\n",
    "\n",
    "print(\"[CELL 3 SELESAI] Label ground truth Fiqih Kifayah berhasil dibuat.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ==============================================================================\n",
    "# CELL 4: PEMBAGIAN DATASET & PELATIHAN MODEL\n",
    "# ==============================================================================\n",
    "\n",
    "X = df_bps[['pendapatan_per_kapita', 'skor_aset', 'jumlah_tanggungan', 'kualitas_hunian', 'akses_sanitasi', 'radiasi_satelit_ntl']]\n",
    "y = df_bps['status_mustahik']\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.20, random_state=SEED, stratify=y\n",
    ")\n",
    "\n",
    "# Model Usulan: Random Forest\n",
    "model_smart = RandomForestClassifier(n_estimators=100, max_depth=5, random_state=SEED)\n",
    "model_smart.fit(X_train, y_train)\n",
    "y_pred_smart = model_smart.predict(X_test)\n",
    "\n",
    "# Simulasi Konvensional: Rule-based survei manual + 20% noise\n",
    "y_pred_konv = y_test.copy().values\n",
    "n_noise = int(0.20 * len(y_pred_konv))\n",
    "noise_indices = np.random.choice(len(y_pred_konv), size=n_noise, replace=False)\n",
    "y_pred_konv[noise_indices] = 1 - y_pred_konv[noise_indices]\n",
    "\n",
    "print(\"[CELL 4 SELESAI] Model SMART-MUSTAHIK dan Simulasi Konvensional berhasil dilatih.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ==============================================================================\n",
    "# CELL 5: EVALUASI PERFORMA & INCLUSION/EXCLUSION ERROR\n",
    "# ==============================================================================\n",
    "\n",
    "def hitung_metrik(y_true, y_pred, nama):\n",
    "    acc = accuracy_score(y_true, y_pred) * 100\n",
    "    prec = precision_score(y_true, y_pred) * 100\n",
    "    rec = recall_score(y_true, y_pred) * 100\n",
    "    f1 = f1_score(y_true, y_pred) * 100\n",
    "    tn, fp, fn, tp = confusion_matrix(y_true, y_pred).ravel()\n",
    "    inc_err = (fp / (fp + tn)) * 100 if (fp + tn) > 0 else 0.0\n",
    "    exc_err = (fn / (fn + tp)) * 100 if (fn + tp) > 0 else 0.0\n",
    "    return {\n",
    "        'Metode': nama,\n",
    "        'Akurasi (%)': round(acc, 2),\n",
    "        'Precision (%)': round(prec, 2),\n",
    "        'Recall (%)': round(rec, 2),\n",
    "        'F1-Score (%)': round(f1, 2),\n",
    "        'Inclusion Error (%)': round(inc_err, 2),\n",
    "        'Exclusion Error (%)': round(exc_err, 2)\n",
    "    }\n",
    "\n",
    "res_konv = hitung_metrik(y_test, y_pred_konv, \"Metode Konvensional (Survei Manual)\")\n",
    "res_smart = hitung_metrik(y_test, y_pred_smart, \"SMART-MUSTAHIK (Model Usulan)\")\n",
    "\n",
    "df_eval = pd.DataFrame([res_konv, res_smart]).set_index('Metode')\n",
    "df_eval.to_csv(os.path.join('data', 'evaluasi_performa.csv'))\n",
    "display(df_eval)\n",
    "print(\"[CELL 5 SELESAI] Tabel perbandingan metrik evaluasi diselesaikan.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
