    "\n",
    "# Subplot 2: Inclusion & Exclusion Error\n",
    "df_p2 = df_eval[['Inclusion Error (%)', 'Exclusion Error (%)']].reset_index().melt(id_vars='Metode', var_name='Jenis Error', value_name='Persentase Error (%)')\n",
    "sns.barplot(data=df_p2, x='Jenis Error', y='Persentase Error (%)', hue='Metode', ax=axes[1], palette=colors)\n",
